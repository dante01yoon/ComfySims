{
  "name": "comfysims",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.13.1",
  "scripts": {
    "verify": "node harness/verify.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "schema:export": "tsx packages/schema/scripts/export-json-schema.ts",
    "fixtures:build": "tsx harness/tools/build-fixtures.ts",
    "web:dev": "vite web --port 5179 --strictPort",
    "web:build": "vite build web",
    "e2e": "playwright test",
    "web:build:nodepack": "vite build web --base /roomfit/ --outDir ../nodes/roomfit/editor --emptyOutDir",
    "comfy:snapshot": "node harness/tools/snapshot-object-info.mjs",
    "see": "node harness/tools/see.mjs",
    "mcp": "tsx mcp/server.ts",
    "plan-diff": "tsx harness/tools/plan-diff.ts",
    "lint": "oxlint --deny-warnings",
    "lint:fix": "oxlint --fix",
    "lint:python": "uvx ruff@0.14.0 check nodes harness",
    "knip": "knip",
    "deps:check": "depcruise web mcp packages harness acceptance demo --config .dependency-cruiser.cjs",
    "check:static": "tsx harness/tools/static-checks.ts",
    "test:coverage": "vitest run --coverage",
    "check": "pnpm lint && pnpm knip && pnpm deps:check && pnpm check:static && pnpm typecheck"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.2.1",
    "@gltf-transform/extensions": "4.5.1",
    "@gltf-transform/functions": "4.5.1",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@playwright/test": "1.56.1",
    "@react-three/drei": "10.7.6",
    "@react-three/fiber": "9.4.0",
    "@react-three/postprocessing": "3.0.4",
    "@types/node": "^22.10.0",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@types/three": "0.180.0",
    "@types/ws": "8.18.1",
    "@vitejs/plugin-react": "5.1.0",
    "@vitest/coverage-v8": "^3.2.7",
    "dependency-cruiser": "^18.6.0",
    "knip": "^6.42.0",
    "meshoptimizer": "1.3.0",
    "oxlint": "^1.88.0",
    "postprocessing": "6.37.8",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "three": "0.180.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "7.1.12",
    "vitest": "^3.0.0",
    "ws": "8.18.3",
    "yaml": "^2.9.1",
    "zod": "^4.1.0"
  },
  "license": "GPL-3.0-only",
  "description": "Real-scale furniture for ComfyUI: product photo + listed size → exact-size 3D → your room → render",
  "repository": "github:dante01yoon/ComfySims"
}
