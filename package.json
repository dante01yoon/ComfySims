{
  "name": "roomfit",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.13.1",
  "scripts": {
    "verify": "node harness/verify.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "schema:export": "tsx packages/schema/scripts/export-json-schema.ts",
    "fixtures:build": "tsx harness/tools/build-fixtures.ts",
    "web:dev": "vite web --port 5179 --strictPort",
    "web:build": "vite build web",
    "e2e": "playwright test",
    "web:build:nodepack": "vite build web --base /roomfit/ --outDir ../nodes/roomfit/editor --emptyOutDir",
    "comfy:snapshot": "node harness/tools/snapshot-object-info.mjs"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.2.1",
    "@playwright/test": "1.56.1",
    "@react-three/drei": "10.7.6",
    "@react-three/fiber": "9.4.0",
    "@react-three/postprocessing": "3.0.4",
    "@types/node": "^22.10.0",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@types/three": "0.180.0",
    "@vitejs/plugin-react": "5.1.0",
    "n8ao": "1.10.1",
    "postprocessing": "6.37.8",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "three": "0.180.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "7.1.12",
    "vitest": "^3.0.0",
    "zod": "^4.1.0"
  },
  "license": "GPL-3.0-only",
  "description": "Real-scale furniture for ComfyUI: product photo + listed size → exact-size 3D → your room → render",
  "repository": "github:dante01yoon/roomfit"
}
