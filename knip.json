{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "web/src/main.tsx",
    "web/vite.config.ts",
    "harness/**/*.{mjs,ts}",
    "packages/*/src/index.ts",
    "packages/schema/scripts/*.ts",
    "demo/*.{mjs,ts}",
