{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "type": "number",
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "units": {
      "type": "string",
      "const": "cm"
    },
    "room": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "box"
            },
            "width": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "depth": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "height": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          },
          "required": [
            "kind",
            "width",
            "depth",
            "height"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "plan"
            },
            "wallHeight": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "wallThickness": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "walls": {
              "minItems": 1,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "from": {
                    "type": "object",
                    "properties": {
                      "x": {
                        "type": "number"
                      },
                      "z": {
                        "type": "number"
                      }
                    },
                    "required": [
                      "x",
                      "z"
                    ],
                    "additionalProperties": false
                  },
                  "to": {
                    "type": "object",
                    "properties": {
                      "x": {
                        "type": "number"
                      },
                      "z": {
                        "type": "number"
                      }
                    },
                    "required": [
                      "x",
                      "z"
                    ],
                    "additionalProperties": false
                  }
                },
                "required": [
                  "id",
                  "from",
                  "to"
                ],
                "additionalProperties": false
              }
            },
            "openings": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "wallId": {
                    "type": "string",
                    "minLength": 1
                  },
                  "kind": {
                    "type": "string",
                    "enum": [
                      "door",
                      "window"
                    ]
                  },
                  "offset": {
                    "type": "number",
                    "minimum": 0
                  },
                  "width": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "height": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "sill": {
                    "type": "number",
                    "minimum": 0
                  }
                },
                "required": [
                  "wallId",
                  "kind",
                  "offset",
                  "width",
                  "height",
                  "sill"
                ],
                "additionalProperties": false
              }
            },
            "zones": {
              "minItems": 1,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "name": {
                    "type": "string",
                    "minLength": 1
                  },
                  "polygon": {
                    "minItems": 3,
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "x": {
                          "type": "number"
                        },
                        "z": {
                          "type": "number"
                        }
                      },
                      "required": [
                        "x",
                        "z"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "floor": {
                    "type": "string",
                    "enum": [
                      "oak",
                      "walnut",
                      "tile",
                      "concrete",
                      "carpet"
                    ]
                  }
                },
                "required": [
                  "id",
                  "name",
                  "polygon",
                  "floor"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "kind",
            "wallHeight",
            "wallThickness",
            "walls",
            "openings",
            "zones"
          ],
          "additionalProperties": false
        }
      ]
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "uri": {
            "type": "string",
            "minLength": 1
          },
          "dimensions": {
            "type": "object",
            "properties": {
              "width": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "depth": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "height": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            },
            "required": [
              "width",
              "depth",
              "height"
            ],
            "additionalProperties": false
          },
          "source": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "const": "upload"
                  }
                },
                "required": [
                  "kind"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "const": "generated"
                  },
                  "workflow": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "kind",
                  "workflow"
                ],
                "additionalProperties": false
              }
            ]
          },
          "fit": {
            "type": "object",
            "properties": {
              "mode": {
                "type": "string",
                "enum": [
                  "exact",
                  "uniform",
                  "auto"
                ]
              },
              "distortion": {
                "type": "number",
                "minimum": 1
              },
              "optimised": {
                "type": "object",
                "properties": {
                  "trianglesBefore": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "trianglesAfter": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "bytesBefore": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "bytesAfter": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "textureSizeBefore": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "textureSizeAfter": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  }
                },
                "required": [
                  "trianglesBefore",
                  "trianglesAfter",
                  "bytesBefore",
                  "bytesAfter",
                  "textureSizeBefore",
                  "textureSizeAfter"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "mode",
              "distortion"
            ],
            "additionalProperties": false
          },
          "thumbnail": {
            "type": "string",
            "maxLength": 56000,
            "pattern": "^data:image\\/(jpeg|png|webp);base64,"
          },
          "product": {
            "type": "object",
            "properties": {
              "photo": {
                "type": "object",
                "properties": {
                  "thumbnail": {
                    "type": "string",
                    "maxLength": 56000,
                    "pattern": "^data:image\\/(jpeg|png|webp);base64,"
                  },
                  "comfyInputName": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "thumbnail"
                ],
                "additionalProperties": false
              },
              "url": {
                "type": "string",
                "format": "uri"
              },
              "brand": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              },
              "store": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              },
              "generatedPhoto": {
                "type": "boolean"
              }
            },
            "additionalProperties": false
          },
          "labels": {
            "maxItems": 12,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 32
            }
          }
        },
        "required": [
          "id",
          "name",
          "uri",
          "dimensions",
          "source"
        ],
        "additionalProperties": false
      }
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "assetId": {
            "type": "string",
            "minLength": 1
          },
          "position": {
            "type": "object",
            "properties": {
              "x": {
                "type": "number"
              },
              "y": {
                "type": "number"
              },
              "z": {
                "type": "number"
              }
            },
            "required": [
              "x",
              "y",
              "z"
            ],
            "additionalProperties": false
          },
          "rotationY": {
            "type": "number",
            "minimum": 0,
            "exclusiveMaximum": 360
          }
        },
        "required": [
          "id",
          "assetId",
          "position",
          "rotationY"
        ],
        "additionalProperties": false
      }
    },
    "site": {
      "type": "object",
      "properties": {
        "lot": {
          "minItems": 3,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "x": {
                "type": "number"
              },
              "z": {
                "type": "number"
              }
            },
            "required": [
              "x",
              "z"
            ],
            "additionalProperties": false
          }
        },
        "ground": {
          "type": "string",
          "enum": [
            "grass",
            "gravel",
            "paving",
            "soil"
          ]
        },
        "houseRotationDeg": {
          "type": "number",
          "minimum": 0,
          "exclusiveMaximum": 360
        },
        "northDeg": {
          "type": "number",
          "minimum": 0,
          "exclusiveMaximum": 360
        },
        "trees": {
          "maxItems": 60,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "x": {
                "type": "number"
              },
              "z": {
                "type": "number"
              }
            },
            "required": [
              "x",
              "z"
            ],
            "additionalProperties": false
          }
        },
        "path": {
          "minItems": 2,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "x": {
                "type": "number"
              },
              "z": {
                "type": "number"
              }
            },
            "required": [
              "x",
              "z"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "lot",
        "ground"
      ],
      "additionalProperties": false
    },
    "blueprint": {
      "type": "object",
      "properties": {
        "image": {
          "type": "string",
          "maxLength": 2800000,
          "pattern": "^data:image\\/(png|jpeg|webp);base64,"
        },
        "cmPerPixel": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "origin": {
          "type": "object",
          "properties": {
            "x": {
              "type": "number"
            },
            "z": {
              "type": "number"
            }
          },
          "required": [
            "x",
            "z"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "image",
        "cmPerPixel",
        "origin"
      ],
      "additionalProperties": false
    },
    "generation": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "enum": [
          "product",
          "render",
          "photo3d",
          "pano360",
          "walkthrough"
        ]
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "workflow": {
            "type": "string",
            "minLength": 1
          },
          "models": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": [
          "workflow"
        ],
        "additionalProperties": false
      }
    },
    "renderStyle": {
      "type": "string",
      "enum": [
        "lived-in",
        "as-built"
      ]
    },
    "customWorkflows": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 1
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "product",
              "render",
              "photo3d",
              "pano360",
              "walkthrough"
            ]
          },
          "graph": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "type": "object",
              "properties": {
                "class_type": {
                  "type": "string",
                  "minLength": 1
                },
                "inputs": {
                  "type": "object",
                  "propertyNames": {
                    "type": "string"
                  },
                  "additionalProperties": {}
                },
                "_meta": {
                  "type": "object",
                  "properties": {
                    "title": {
                      "type": "string"
                    }
                  },
                  "additionalProperties": false
                }
              },
              "required": [
                "class_type",
                "inputs"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "kind",
          "graph"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "version",
    "id",
    "name",
    "units",
    "room",
    "assets",
    "items"
  ],
  "additionalProperties": false
}
